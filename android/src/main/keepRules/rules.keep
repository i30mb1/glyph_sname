# R8 keep rules of this app. AGP passes every file in src/main/keepRules to R8.
# Libraries bring their own rules; add here only what this app's code needs. Keep rules narrow.

# The Glyph Matrix SDK is called through AIDL/Binder; keep it intact.
-keep class com.nothing.ketchum.** { *; }

# Extra optimizations
-optimizationpasses 5
-allowaccessmodification
-repackageclasses ''

# Strip verbose, debug and info logs from release
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}

# Strip Kotlin null-check intrinsics
-assumenosideeffects class kotlin.jvm.internal.Intrinsics {
    public static void checkNotNull(...);
    public static void checkNotNullParameter(...);
    public static void checkNotNullExpressionValue(...);
}
